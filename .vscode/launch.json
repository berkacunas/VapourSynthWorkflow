{
    "version": "0.2.0",
    "configurations": [
        {   // Python Debugger: Current File
            "name":"Python Debugger: Current File",
            "type":"debugpy",
            "request":"launch",
            "program":"${file}",
            "console":"integratedTerminal",
            "justMyCode": true
        },
        {
            "type": "debugpy",
            "request": "launch",
            "name": "Python Debugger: Current Module with args",
            "program": "${workspaceFolder}/main.py",
            "cwd": "${workspaceFolder}",
            "args": [
                "demux", "-h"
            ]
        }
    ]
}